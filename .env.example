# ─────────────────────────────────────────────────────────────
# 로컬 개발 시에는 이 파일을 .env.local 로 복사해서 사용하세요.
#   cp .env.example .env.local
# .env.local 은 git에 커밋되지 않습니다(.gitignore).
# ─────────────────────────────────────────────────────────────

# Channel.io 채팅 위젯 플러그인 키
# https://developers.channel.io/docs/web-installation
# 값이 비어 있으면 채팅 위젯만 로드되지 않고, 나머지 사이트 기능은 정상 동작합니다.
# 운영(Vercel) 환경에서는 실제 키를 환경 변수로 주입합니다.
NEXT_PUBLIC_CHANNEL_IO_KEY=

# ─────────────────────────────────────────────────────────────
# 검색엔진 소유권 확인 토큰 (선택)
# 값이 있을 때만 <meta> 태그가 렌더링됩니다.
# ─────────────────────────────────────────────────────────────

# Google Search Console > 설정 > 소유권 확인 > HTML 태그에서 발급받은 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 > 사이트 관리 > 소유확인에서 발급받은 content 값
# 비워두면 저장소에 커밋된 기존 토큰이 그대로 사용됩니다.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
